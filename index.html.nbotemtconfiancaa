<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StudyHub 2.0 - Elite Learning</title>
    
    <!-- Biblioteca Vis.js para o Grafo de Conhecimento -->
    <script type="text/javascript" src="https://unpkg.com/vis-network/standalone/umd/vis-network.min.js"></script>

    <style>
        :root {
            --bg-primary: #ffffff;
            --bg-secondary: #f8f9fa;
            --bg-card: #ffffff;
            --text-primary: #1a1a1a;
            --text-secondary: #6c757d;
            --border: #e0e0e0;
            --accent: #6366f1;
            --accent-hover: #4f46e5;
            --success: #10b981;
            --warning: #f59e0b;
            --danger: #ef4444;
            --shadow: rgba(0, 0, 0, 0.1);
        }

        [data-theme="dark"] {
            --bg-primary: #1a1a1a;
            --bg-secondary: #2d2d2d;
            --bg-card: #242424;
            --text-primary: #ffffff;
            --text-secondary: #a0a0a0;
            --border: #404040;
            --shadow: rgba(0, 0, 0, 0.3);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg-primary); color: var(--text-primary); transition: all 0.3s; line-height: 1.6; }

        /* ========== CONTROLE DE ACESSO (PAIS) ========== */
        body.is-parent .hide-on-parent { display: none !important; }
        .parent-dashboard { display: none; background: linear-gradient(135deg, var(--warning), #d97706); color: white; padding: 15px 20px; text-align: center; }
        body.is-parent .parent-dashboard { display: block; }
        .student-inbox { display: none; background: rgba(99, 102, 241, 0.1); border-left: 4px solid var(--accent); padding: 15px; margin-bottom: 20px; border-radius: 8px; }
        body.is-student .student-inbox { display: block; }

        /* ========== LOGIN ========== */
        .login-container { min-height: 100vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%); padding: 20px; }
        .login-box { background: var(--bg-card); padding: 40px; border-radius: 20px; box-shadow: 0 20px 60px rgba(0,0,0,0.3); width: 100%; max-width: 450px; animation: slideUp 0.5s ease-out; }
        @keyframes slideUp { from { opacity: 0; transform: translateY(30px); } to { opacity: 1; transform: translateY(0); } }
        .login-header { text-align: center; margin-bottom: 30px; }
        .login-header h1 { font-size: 2.2em; margin-bottom: 8px; background: linear-gradient(135deg, #6366f1, #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 500; font-size: 0.9em; }
        .form-input { width: 100%; padding: 12px 16px; border: 2px solid var(--border); border-radius: 10px; font-size: 1em; transition: all 0.3s; background: var(--bg-secondary); color: var(--text-primary); }
        .form-input:focus { outline: none; border-color: var(--accent); }
        
        .btn { width: 100%; padding: 14px; border: none; border-radius: 10px; font-size: 1em; font-weight: 600; cursor: pointer; transition: all 0.3s; }
        .btn-primary { background: linear-gradient(135deg, var(--accent), #8b5cf6); color: white; }
        .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(99, 102, 241, 0.4); }
        
        .toggle-form { text-align: center; margin-top: 20px; color: var(--text-secondary); }
        .toggle-form a { color: var(--accent); cursor: pointer; font-weight: 600; }
        .alert { padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 0.9em; }
        .alert-error { background: rgba(239, 68, 68, 0.1); color: var(--danger); border: 1px solid var(--danger); }
        .alert-success { background: rgba(16, 185, 129, 0.1); color: var(--success); border: 1px solid var(--success); }

        /* ========== APP NAVBAR & TABS ========== */
        .app-container { display: none; }
        .app-container.active { display: block; }
        .navbar { background: var(--bg-card); border-bottom: 1px solid var(--border); padding: 16px 0; position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 10px var(--shadow); }
        .navbar-content { max-width: 1400px; margin: 0 auto; padding: 0 20px; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 1.5em; font-weight: 700; background: linear-gradient(135deg, var(--accent), #8b5cf6); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .navbar-actions { display: flex; gap: 12px; align-items: center; }
        .theme-toggle { background: var(--bg-secondary); border: none; width: 40px; height: 40px; border-radius: 10px; cursor: pointer; font-size: 1.2em; color: var(--text-primary); transition: all 0.3s; }
        .user-info { display: flex; align-items: center; gap: 12px; padding: 8px 16px; background: var(--bg-secondary); border-radius: 10px; }
        .user-avatar { width: 32px; height: 32px; background: linear-gradient(135deg, var(--accent), #8b5cf6); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; }
        .btn-logout { padding: 8px 16px; background: var(--danger); color: white; border: none; border-radius: 8px; cursor: pointer; font-weight: 500; }
        
        .tabs { max-width: 1400px; margin: 0 auto; padding: 20px 20px 0; display: flex; gap: 8px; border-bottom: 2px solid var(--border); overflow-x: auto; }
        .tab { padding: 12px 24px; background: transparent; border: none; border-bottom: 3px solid transparent; cursor: pointer; font-size: 1em; font-weight: 600; color: var(--text-secondary); transition: all 0.3s; white-space: nowrap; }
        .tab.active { color: var(--accent); border-bottom-color: var(--accent); }
        .main-content { max-width: 1400px; margin: 0 auto; padding: 30px 20px; }
        .tab-content { display: none; animation: fadeIn 0.3s; }
        .tab-content.active { display: block; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        /* ========== UI COMPONENTS (STATS & TASKS) ========== */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background: var(--bg-card); padding: 24px; border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 2px 8px var(--shadow); transition: all 0.3s; cursor: pointer; }
        .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 20px var(--shadow); }
        .stat-icon { font-size: 1.5em; margin-bottom: 8px; }
        .stat-label { font-size: 0.85em; color: var(--text-secondary); margin-bottom: 8px; }
        .stat-value { font-size: 1.8em; font-weight: 700; }
        .stat-percentage { font-size: 0.85em; color: var(--text-secondary); margin-top: 4px; }
        
        .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 15px; }
        .section-title { font-size: 1.5em; font-weight: 700; }
        .btn-add { padding: 12px 24px; background: var(--accent); color: white; border: none; border-radius: 10px; cursor: pointer; font-weight: 600; display: flex; align-items: center; gap: 8px; transition: 0.3s; }
        .btn-add:hover { background: var(--accent-hover); transform: translateY(-2px); }

        .filters { display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap; }
        .filter-select { padding: 10px 16px; border: 2px solid var(--border); border-radius: 10px; background: var(--bg-card); color: var(--text-primary); cursor: pointer; }

        .tasks-container { display: flex; flex-direction: column; gap: 12px; }
        .task-card { background: var(--bg-card); padding: 20px; border-radius: 12px; border: 2px solid var(--border); box-shadow: 0 2px 8px var(--shadow); cursor: pointer; transition: 0.3s; }
        .task-card:hover { transform: translateY(-2px); box-shadow: 0 4px 12px var(--shadow); }
        .task-card.completed { border-color: var(--success); opacity: 0.8; }
        .task-card.overdue { border-color: var(--danger); }
        .task-card.near-deadline { border-color: var(--warning); }
        .task-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px; }
        .task-title { font-size: 1.1em; font-weight: 600; flex: 1; }
        .task-priority { padding: 4px 12px; border-radius: 6px; font-size: 0.75em; font-weight: 600; text-transform: uppercase; }
        .priority-high { background: rgba(239, 68, 68, 0.2); color: var(--danger); }
        .priority-medium { background: rgba(245, 158, 11, 0.2); color: var(--warning); }
        .priority-low { background: rgba(16, 185, 129, 0.2); color: var(--success); }
        .task-meta { display: flex; gap: 16px; font-size: 0.9em; color: var(--text-secondary); flex-wrap: wrap; }
        .task-status { display: inline-block; padding: 4px 10px; border-radius: 12px; font-size: 0.75em; font-weight: 600; margin-top: 8px; }
        .status-pending { background: rgba(99, 102, 241, 0.1); color: var(--accent); }
        .status-completed { background: rgba(16, 185, 129, 0.1); color: var(--success); }
        .status-overdue { background: rgba(239, 68, 68, 0.1); color: var(--danger); }
        .spaced-badge { background: #8b5cf6; color: white; padding: 3px 8px; border-radius: 8px; font-size: 0.75em; margin-left: 10px; vertical-align: middle; }

        /* ========== ABA IA & SEGUNDO CÉREBRO ========== */
        .ai-grid { display: grid; grid-template-columns: 2fr 1fr; gap: 20px; }
        @media(max-width: 900px) { .ai-grid { grid-template-columns: 1fr; } }
        .graph-container { border: 2px solid var(--border); border-radius: 16px; height: 500px; background: var(--bg-secondary); overflow: hidden; }
        .chat-container { border: 2px solid var(--border); border-radius: 16px; display: flex; flex-direction: column; height: 500px; background: var(--bg-card); }
        .chat-messages { flex: 1; padding: 20px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; }
        .chat-bubble { max-width: 85%; padding: 12px 16px; border-radius: 12px; font-size: 0.95em; }
        .chat-ai { background: rgba(99, 102, 241, 0.1); border-bottom-left-radius: 2px; align-self: flex-start; }
        .chat-user { background: var(--accent); color: white; border-bottom-right-radius: 2px; align-self: flex-end; }
        .chat-input { display: flex; padding: 15px; border-top: 1px solid var(--border); gap: 10px; }
        
        .ai-tools { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-top: 20px; }
        .ai-tool-btn { padding: 20px; text-align: center; border: 2px dashed var(--accent); border-radius: 12px; cursor: pointer; color: var(--text-primary); font-weight: 600; transition: 0.3s; background: var(--bg-card); }
        .ai-tool-btn:hover { background: rgba(99, 102, 241, 0.05); transform: translateY(-2px); }

        /* ========== ABA FOCO & PROVA ========== */
        .focus-panel { background: var(--bg-card); border: 2px solid var(--border); border-radius: 20px; padding: 40px; text-align: center; }
        .timer-display { font-size: 6rem; font-weight: bold; font-variant-numeric: tabular-nums; color: var(--accent); margin: 20px 0; }
        .focus-controls { display: flex; justify-content: center; gap: 15px; margin-bottom: 30px; flex-wrap: wrap; }
        .focus-select { padding: 12px; border-radius: 10px; border: 2px solid var(--border); background: var(--bg-secondary); color: var(--text-primary); font-size: 1em; }
        .btn-exam { background: var(--danger); color: white; width: auto; padding: 15px 40px; }
        
        #examOverlay { display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: #000000; z-index: 9999; color: white; flex-direction: column; align-items: center; justify-content: center; }
        #examOverlay.active { display: flex; }
        .exam-timer { font-size: 8rem; color: var(--danger); font-weight: bold; margin-bottom: 30px; }

        /* ========== PLANEJAMENTO (CALENDÁRIO) ========== */
        .calendar-container { background: var(--bg-card); padding: 24px; border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 2px 8px var(--shadow); }
        .calendar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .calendar-month-year { font-size: 1.3em; font-weight: 700; }
        .calendar-nav button { background: var(--bg-secondary); color: var(--text-primary); border: none; width: 36px; height: 36px; border-radius: 8px; cursor: pointer; font-size: 1.2em; }
        .calendar-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; margin-bottom: 8px; text-align: center; font-weight: 600; color: var(--text-secondary); }
        .calendar-days { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
        .calendar-day { aspect-ratio: 1; padding: 8px; background: var(--bg-secondary); border: 2px solid transparent; border-radius: 8px; text-align: center; cursor: pointer; position: relative; }
        .calendar-day.today { background: var(--accent); color: white; }
        .calendar-day.other-month { opacity: 0.3; }
        .calendar-day.has-tasks { border-color: var(--accent); }
        .calendar-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); display: inline-block; margin: 1px; }
        
        .planning-quick-add { background: var(--bg-secondary); padding: 16px; border-radius: 12px; margin-bottom: 20px; }
        .planning-quick-form { display: flex; gap: 8px; flex-wrap: wrap; }
        .planning-quick-form input { flex: 1; min-width: 150px; padding: 10px; border: 2px solid var(--border); border-radius: 8px; background: var(--bg-card); color: var(--text-primary); }
        
        .week-view { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; }
        .day-column { background: var(--bg-card); padding: 16px; border-radius: 12px; border: 1px solid var(--border); }
        .day-header { font-weight: 700; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 2px solid var(--border); }
        .day-task-item { padding: 8px; background: var(--bg-secondary); border-radius: 6px; margin-bottom: 8px; font-size: 0.9em; cursor: pointer; }

        /* ========== MODAIS GERAIS ========== */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.6); z-index: 1000; align-items: center; justify-content: center; padding: 20px; backdrop-filter: blur(4px); }
        .modal.active { display: flex; }
        .modal-content { background: var(--bg-card); padding: 30px; border-radius: 16px; width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; }
        .modal-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        .modal-title { font-size: 1.4em; font-weight: 700; }
        .btn-close { background: none; border: none; font-size: 1.5em; cursor: pointer; color: var(--text-secondary); }
        .btn-group { display: flex; gap: 12px; margin-top: 20px; }
        .btn-secondary { flex: 1; padding: 12px; border: 2px solid var(--border); border-radius: 8px; background: transparent; color: var(--text-primary); font-weight: 600; cursor: pointer; }
        .btn-danger { flex: 1; padding: 12px; border: none; border-radius: 8px; background: var(--danger); color: white; font-weight: 600; cursor: pointer; }
        
        textarea.form-input { resize: vertical; min-height: 100px; }
        .empty-state { text-align: center; padding: 60px 20px; color: var(--text-secondary); }

        /* FLASHCARDS CSS */
        .flashcard { width: 100%; height: 150px; perspective: 1000px; cursor: pointer; margin-bottom: 15px; }
        .flashcard-inner { position: relative; width: 100%; height: 100%; text-align: center; transition: transform 0.6s; transform-style: preserve-3d; }
        .flashcard.flipped .flashcard-inner { transform: rotateY(180deg); }
        .flashcard-front, .flashcard-back { position: absolute; width: 100%; height: 100%; backface-visibility: hidden; display: flex; align-items: center; justify-content: center; padding: 20px; border-radius: 12px; border: 2px solid var(--accent); background: var(--bg-card); box-shadow: 0 4px 8px var(--shadow);}
        .flashcard-back { transform: rotateY(180deg); background: rgba(99, 102, 241, 0.1); }
    </style>
</head>
<body>

    <!-- PAINEL DO RESPONSÁVEL -->
    <div class="parent-dashboard">
        <strong>👁️ Painel do Responsável</strong> | Monitorando: 
        <select id="childSelector" style="padding: 5px; border-radius: 5px; margin: 0 10px; background:white; color:black;">
            <option>Selecione um filho...</option>
            <option value="filho1">Filho (Conta Atual)</option>
        </select>
        <button onclick="sendParentMessage()" style="padding: 5px 15px; border-radius: 5px; border: none; background: white; color: var(--warning); font-weight: bold; cursor: pointer;">📩 Enviar Cobrança</button>
    </div>

    <!-- LOGIN PAGE -->
    <div class="login-container" id="authPage">
        <div class="login-box">
            <div class="login-header">
                <h1>📚 StudyHub 2.0</h1>
                <p id="authSubtitle">Plataforma de Alta Performance</p>
            </div>

            <div id="alertContainer"></div>

            <form id="loginForm">
                <div class="form-group">
                    <label>E-mail (Dica: digite 'pai' para testar como Responsável)</label>
                    <input type="email" id="loginEmail" class="form-input" required>
                </div>
                <div class="form-group">
                    <label>Senha</label>
                    <input type="password" id="loginPassword" class="form-input" required>
                </div>
                <button type="submit" class="btn btn-primary">🔐 Entrar</button>
            </form>

            <form id="registerForm" style="display: none;">
                <div class="form-group">
                    <label>Eu sou:</label>
                    <select id="regRole" class="form-input" onchange="toggleRegFields()" required>
                        <option value="student">Aluno</option>
                        <option value="parent">Pai / Responsável</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Nome completo</label>
                    <input type="text" id="registerName" class="form-input" required>
                </div>
                <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" id="registerEmail" class="form-input" required>
                </div>
                
                <div id="whatsappFields">
                    <div class="form-group">
                        <label>WhatsApp do Responsável (Obrigatório para Alertas)</label>
                        <input type="text" id="regParentPhone" class="form-input" placeholder="(00) 00000-0000">
                    </div>
                    <div class="form-group">
                        <label>Seu WhatsApp (Opcional)</label>
                        <input type="text" id="regStudentPhone" class="form-input" placeholder="(00) 00000-0000">
                    </div>
                </div>

                <div class="form-group">
                    <label>Senha</label>
                    <input type="password" id="registerPassword" class="form-input" required minlength="6">
                </div>
                <button type="submit" class="btn btn-primary">✨ Criar conta</button>
            </form>

            <div class="toggle-form">
                <span id="toggleText">Não tem uma conta?</span>
                <a id="toggleLink">Criar conta</a>
            </div>
        </div>
    </div>

    <!-- APP -->
    <div class="app-container" id="appContainer">
        <nav class="navbar">
            <div class="navbar-content">
                <div class="logo">📚 StudyHub 2.0</div>
                <div class="navbar-actions">
                    <button class="theme-toggle" id="themeToggle">🌙</button>
                    <div class="user-info">
                        <div class="user-avatar" id="userAvatar">A</div>
                        <span id="userName">Usuário</span>
                    </div>
                    <button class="btn-logout" id="logoutBtn">Sair</button>
                </div>
            </div>
        </nav>

        <div class="tabs">
            <button class="tab active" data-tab="tasks">📋 Tarefas</button>
            <button class="tab" data-tab="ai">🧠 Inteligência (IA)</button>
            <button class="tab" data-tab="focus">⏱️ Foco & Prova</button>
            <button class="tab" data-tab="exams">📝 Provas</button>
            <button class="tab" data-tab="planning">📅 Planejamento</button>
        </div>

        <main class="main-content">
            
            <!-- ABA TAREFAS -->
            <div class="tab-content active" id="tasks-tab">
                <div class="student-inbox" id="studentInbox">
                    <strong>🔔 Alerta do Responsável:</strong>
                    <span id="inboxMessage" style="margin-left: 10px;">Nenhuma mensagem nova.</span>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">📋</div>
                        <div class="stat-label">Total de Tarefas</div>
                        <div class="stat-value" id="statTotal">0</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">⏳</div>
                        <div class="stat-label">Pendentes</div>
                        <div class="stat-value" id="statPending">0</div>
                        <div class="stat-percentage" id="statPendingPercent">0%</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">⚠️</div>
                        <div class="stat-label">Atrasadas</div>
                        <div class="stat-value" id="statOverdue">0</div>
                        <div class="stat-percentage" id="statOverduePercent">0%</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">✅</div>
                        <div class="stat-label">Concluídas</div>
                        <div class="stat-value" id="statCompleted">0</div>
                        <div class="stat-percentage" id="statCompletedPercent">0%</div>
                    </div>
                    <div class="stat-card" id="timeCard" style="cursor: pointer;">
                        <div class="stat-icon">⏱️</div>
                        <div class="stat-label">Tempo Estimado Total</div>
                        <div class="stat-value" id="statTime">0h</div>
                        <div class="stat-percentage">Clique para ver por matéria</div>
                    </div>
                </div>

                <div class="section-header">
                    <h2 class="section-title">Minhas Tarefas</h2>
                    <button class="btn-add hide-on-parent" id="addTaskBtn">➕ Nova Tarefa</button>
                </div>

                <div class="filters">
                    <select class="filter-select" id="filterSubject"><option value="">Todas as matérias</option></select>
                    <select class="filter-select" id="filterPriority">
                        <option value="">Todas as prioridades</option><option value="high">Alta</option><option value="medium">Média</option><option value="low">Baixa</option>
                    </select>
                    <select class="filter-select" id="filterStatus">
                        <option value="">Todos os status</option><option value="pending">Pendente</option><option value="completed">Concluída</option><option value="overdue">Atrasada</option>
                    </select>
                    <select class="filter-select" id="sortBy">
                        <option value="deadline">Ordenar por: Data</option><option value="priority">Ordenar por: Prioridade</option><option value="subject">Ordenar por: Matéria</option>
                    </select>
                </div>

                <div class="tasks-container" id="tasksContainer"></div>
            </div>

            <!-- ABA INTELIGÊNCIA (IA) -->
            <div class="tab-content" id="ai-tab">
                <div class="section-header">
                    <h2 class="section-title">Segundo Cérebro & IA</h2>
                </div>

                <div class="ai-grid">
                    <div>
                        <h3 style="
                        